    <script>
        const apiKey = ""; 
        const editor = document.getElementById('editor');
        const logs = document.getElementById('logs');
        const aiStatus = document.getElementById('ai-status');
        const keyCard = document.getElementById('key-card');
        const keyInput = document.getElementById('key-input');
        const keyError = document.getElementById('key-error');

        function checkKey() {
            if (keyInput.value === "111") {
                document.getElementById('key-system').style.display = 'none';
                document.getElementById('main-app').classList.remove('hidden');
                addLog("Giriş yapıldı. Cihaz: " + (window.innerWidth < 768 ? 'Mobil' : 'PC'));
            } else {
                keyCard.classList.remove('shake');
                void keyCard.offsetWidth; // Reflow to restart animation
                keyCard.classList.add('shake');
                keyError.style.opacity = "1";
                setTimeout(() => keyError.style.opacity = "0", 2000);
            }
        }

        function switchTab(id, btn) {
            document.querySelectorAll('.tab-content').forEach(t => t.classList.add('hidden'));
            document.getElementById(`tab-${id}`).classList.remove('hidden');
            document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }

        async function generateAI() {
            const prompt = document.getElementById('ai-prompt').value;
            if(!prompt) return;

            const btnLabel = document.getElementById('gen-label');
            const loader = document.getElementById('gen-loader');

            btnLabel.innerText = "YAZILIYOR...";
            loader.classList.remove('hidden');
            aiStatus.innerText = "Kod mimarisi oluşturuluyor...";

            try {
                const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-09-2025:generateContent?key=${apiKey}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        contents: [{ parts: [{ text: prompt }] }],
                        systemInstruction: { parts: [{ text: "Sen bir Roblox Luau uzmanısın. Sadece çalışan kod ver, açıklama yapma." }] }
                    })
                });
                const data = await response.json();
                const code = data.candidates[0].content.parts[0].text.replace(/```[a-z]*\n/g, '').replace(/\n```/g, '').trim();
                editor.value = code;
                switchTab('exec', document.querySelector('.nav-btn'));
                addLog("AI: Script başarıyla üretildi.");
            } catch(e) {
                addLog("Hata: AI'ya ulaşılamadı.", "text-red-500");
            } finally {
                btnLabel.innerText = "SCRIPT ÜRET";
                loader.classList.add('hidden');
                aiStatus.innerText = "Hazır.";
            }
        }

        async function aiAction(type) {
            if(!editor.value) return;
            aiStatus.innerText = "İşleniyor...";
            addLog("AI işlemi başlatıldı...");
            setTimeout(() => {
                aiStatus.innerText = "Tamamlandı.";
                addLog(`Kod başarıyla ${type === 'fix' ? 'düzeltildi' : 'gizlendi'}.`, "text-blue-400");
            }, 1000);
        }

        function loadScript(type) {
            const scripts = {
                'iy': 'loadstring(game:HttpGet("https://raw.githubusercontent.com/EdgeIY/infiniteyield/master/source"))()',
                'blox': '-- Blox Fruits Auto Farm\nloadstring(game:HttpGet("https://raw.githubusercontent.com/RealHacker/BloxHub/main/script.lua"))()',
                'mm2': '-- MM2 ESP\nloadstring(game:HttpGet("https://raw.githubusercontent.com/Ghostly/MM2-ESP/main/loader.lua"))()'
            };
            editor.value = scripts[type];
            switchTab('exec', document.querySelectorAll('.nav-btn')[0]);
            addLog(`${type} yüklendi.`);
        }

        function execute() {
            if(!editor.value) return;
            addLog("Enjeksiyon başlatılıyor...", "text-yellow-500");
            setTimeout(() => {
                addLog("Bypass başarılı. Script çalıştırıldı.", "text-green-500");
            }, 800);
        }

        function addLog(msg, color = "text-slate-400") {
            const div = document.createElement('div');
            div.className = color;
            div.innerHTML = `<span class="opacity-20 mr-2">${new Date().toLocaleTimeString()}</span> ${msg}`;
            logs.appendChild(div);
            logs.scrollTop = logs.scrollHeight;
        }

        function clearEditor() {
            editor.value = '';
            addLog("Editör temizlendi.", "text-red-400");
        }

        function copyCode() {
            if(!editor.value) return;
            // Use legacy copy for iframe compatibility
            const el = document.createElement('textarea');
            el.value = editor.value;
            document.body.appendChild(el);
            el.select();
            document.execCommand('copy');
            document.body.removeChild(el);
            addLog("Kod panoya kopyalandı.", "text-purple-400");
        }

        function logout() { location.reload(); }
    </script>
</body>
</html>
